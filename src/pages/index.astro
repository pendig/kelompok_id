---
const capabilities = [
  { icon: "◎", title: "Profil publik", copy: "Satu rumah digital yang membuat organisasi mudah ditemukan dan dipercaya." },
  { icon: "↗", title: "Event & kabar", copy: "Terbitkan kegiatan, artikel, pengumuman, dan cerita dampak dari satu tempat." },
  { icon: "◇", title: "Donasi transparan", copy: "Buka kampanye dan tunjukkan bagaimana dukungan berubah menjadi manfaat nyata." },
  { icon: "✦", title: "Laporan dampak", copy: "Hubungkan kerja organisasi dengan SDGs dan bukti yang dapat ditelusuri." },
];

const values = ["Akses lebih awal", "Kesempatan memberi masukan", "Kabar perkembangan produk", "Pendampingan uji coba"];

const movements = [
  { label: "Organisasi", title: "Organisasi & komunitas", copy: "Ruang tumbuh bagi kelompok yang menggerakkan perubahan dari kampus hingga lingkungan sekitar." },
  { label: "Pengetahuan", title: "Pendidikan & literasi", copy: "Cerita tentang gagasan, kaderisasi, dan keberanian anak muda memperluas pengetahuan." },
  { label: "Kepedulian", title: "Aksi sosial", copy: "Kerja bersama yang hadir saat masyarakat membutuhkan bantuan dan keberpihakan." },
  { label: "Masa depan", title: "Prestasi & isu publik", copy: "Pencapaian, suara kritis, dan partisipasi anak muda dalam menentukan masa depan." },
];

const stories = [
  { type: "SUARA KAMPUS", title: "Realita negeri disuarakan dari UGM", href: "https://www.instagram.com/kelompok_id/reel/DcfzNy3TzAq/" },
  { type: "GERAK BERSAMA", title: "Mahasiswa baru menyerukan kepedulian", href: "https://www.instagram.com/kelompok_id/reel/Dce3Ytozb1M/" },
  { type: "LITERASI", title: "Anak muda diajak lebih dekat dengan buku", href: "https://www.instagram.com/kelompok_id/p/DcconDBzlzk/" },
];

const siteUrl = "https://kelompok.id/";
const pageTitle = "Kelompok.id | Platform Organisasi & Komunitas";
const pageDescription = "Kelompok membantu organisasi dan komunitas mengelola kegiatan, membangun kepercayaan, serta menunjukkan dampak. Segera hadir, ikuti uji coba kami.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Kelompok.id",
      url: siteUrl,
      logo: `${siteUrl}brand/logo-square.png`,
      description: pageDescription,
      sameAs: ["https://www.instagram.com/kelompok_id"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Kelompok.id",
      inLanguage: "id-ID",
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#4b168f" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Kelompok.id" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo Kelompok.id" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}og-image.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <header class="site-header">
      <a class="brand" href="#" aria-label="Kelompok.id, kembali ke atas">
        <img src="/brand/kelompok-logo.png" alt="Kelompok.id" width="430" height="100" />
      </a>
      <nav aria-label="Navigasi utama">
        <a href="#tentang">Tentang</a>
        <a href="#gerakan">Gerakan</a>
        <a href="#fitur">Solusi</a>
        <a href="#waitlist">Waitlist</a>
      </nav>
      <a class="header-cta" href="https://www.instagram.com/kelompok_id">Ikuti Instagram <span aria-hidden="true">↗</span></a>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Platform organisasi & komunitas · Coming soon</p>
          <h1 id="hero-title">Gerakan besar<br />bermula dari<br /><em>kelompok.</em></h1>
          <p class="hero-lead">Kelompok sedang kami siapkan untuk membantu organisasi hadir, mengelola kegiatan, dan menunjukkan dampaknya kepada dunia.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#fitur">Lihat rencana solusi <span>→</span></a>
            <a class="text-link" href="https://www.instagram.com/kelompok_id">DM untuk ikut uji coba <span>↗</span></a>
          </div>
        </div>

        <div class="orbit" aria-label="Profil organisasi menjadi pusat kegiatan, donasi, kabar, dan laporan dampak">
          <div class="orbit-ring ring-one"></div>
          <div class="orbit-ring ring-two"></div>
          <div class="profile-card">
            <div class="profile-cover"></div>
            <img class="profile-logo" src="/brand/logo-square.png" alt="" width="230" height="226" />
            <p class="profile-kicker">PROFIL ORGANISASI</p>
            <h2>Rumah untuk gerakanmu.</h2>
            <div class="profile-status"><i></i> Terverifikasi & transparan</div>
          </div>
          <span class="orbit-pill pill-event">Kalender event</span>
          <span class="orbit-pill pill-impact">Laporan dampak</span>
          <span class="orbit-pill pill-donor">Donasi terbuka</span>
          <span class="orbit-pill pill-story">Cerita terbaru</span>
        </div>
      </section>

      <section class="manifesto" id="tentang" aria-labelledby="manifesto-title">
        <p class="section-label">Mengapa Kelompok</p>
        <div>
          <h2 id="manifesto-title">Kerja baik layak mendapat<br /><span>infrastruktur yang baik.</span></h2>
          <p>Banyak organisasi bekerja nyata, tetapi cerita, data, dan dampaknya tercecer di banyak tempat. Kelompok menyatukannya dalam profil publik yang mudah dikelola. Dengan begitu, energi tim kembali pada gerakan, bukan administrasi.</p>
        </div>
      </section>

      <section class="movement" id="gerakan" aria-labelledby="movement-title">
        <div class="movement-lead">
          <p class="section-label light">Dari gerakan nyata</p>
          <h2 id="movement-title">Kami mengikuti mereka yang memilih untuk <em>bergerak.</em></h2>
          <p>Setiap hari, anak muda, organisasi, dan komunitas mengubah kepedulian menjadi tindakan. Kelompok sedang dibangun agar kerja mereka lebih mudah ditemukan, dikelola, dan dipercaya.</p>
          <a class="text-link movement-link" href="https://www.instagram.com/kelompok_id">Ikuti cerita di @kelompok_id <span>↗</span></a>
        </div>
        <div class="movement-board" aria-label="Ragam gerakan yang disoroti Kelompok">
          {movements.map((item, index) => (
            <article>
              <div class="movement-meta"><span>{String(index + 1).padStart(2, "0")}</span>{item.label}</div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="editorial" aria-labelledby="editorial-title">
        <div class="editorial-heading">
          <div>
            <p class="section-label">Dari Instagram Kelompok</p>
            <h2 id="editorial-title">Cerita yang sedang bergerak.</h2>
          </div>
          <p>Sorotan pilihan tentang gagasan, kepedulian, dan kerja kolektif anak muda Indonesia.</p>
        </div>
        <div class="story-grid">
          {stories.map((story, index) => (
            <a class={`story-card story-${index + 1}`} href={story.href} aria-label={`${story.title}, buka di Instagram`}>
              <span class="story-type">{story.type}</span>
              <strong>{story.title}</strong>
              <span class="story-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <div class="story-pitch">
          <p><strong>Punya cerita kegiatan atau gerakan?</strong> Kabari kami agar lebih banyak kerja baik dapat ditemukan.</p>
          <a class="button button-primary" href="https://www.instagram.com/kelompok_id">Kirim cerita via DM <span>↗</span></a>
        </div>
      </section>

      <section class="solutions" id="fitur" aria-labelledby="solutions-title">
        <div class="section-intro">
          <p class="section-label light">Solusi yang tumbuh bersamamu</p>
          <h2 id="solutions-title">Satu pusat.<br />Banyak gerakan.</h2>
          <p>Mulai dari profil yang sederhana. Tambahkan kebutuhan lain ketika organisasimu siap.</p>
        </div>
        <div class="capability-grid">
          {capabilities.map((item) => (
            <article>
              <span class="capability-icon" aria-hidden="true">{item.icon}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="open" id="waitlist" aria-labelledby="open-title">
        <div class="open-visual" aria-hidden="true">
          <div class="code-window">
            <div class="code-bar"><i></i><i></i><i></i><span>kelompok.id / early access</span></div>
            <pre><code><b>COMING SOON</b>

Platform belum dirilis.
Ingin menjadi pengguna awal?

<span>DM @kelompok_id</span></code></pre>
          </div>
        </div>
        <div class="open-copy">
          <p class="section-label">Uji coba & waitlist</p>
          <h2 id="open-title">Ikut mencoba Kelompok lebih awal.</h2>
          <p>Kelompok belum dirilis. Jika organisasi atau komunitasmu ingin ikut uji coba dan masuk waitlist, kirim DM kepada kami melalui Instagram.</p>
          <ul>
            {values.map((value) => <li><span>✓</span>{value}</li>)}
          </ul>
          <a class="text-link dark" href="https://www.instagram.com/kelompok_id">DM @kelompok_id <span>↗</span></a>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="cta-title">
        <img src="/brand/logo-square.png" alt="" width="230" height="226" loading="lazy" />
        <p class="section-label light">The Solutions of Movement</p>
        <h2 id="cta-title">Saatnya gerakanmu<br /><em>punya rumah.</em></h2>
        <p>Platform ini masih dalam tahap persiapan dan belum dirilis. Hubungi kami untuk ikut uji coba atau masuk waitlist.</p>
        <a class="button button-gold" href="https://www.instagram.com/kelompok_id">DM di Instagram <span>↗</span></a>
      </section>
    </main>

    <footer>
      <img src="/brand/kelompok-logo.png" alt="Kelompok.id" width="430" height="100" loading="lazy" />
      <p>Infrastruktur untuk gerakan yang berdampak.</p>
      <p>© {new Date().getFullYear()} Kelompok.id</p>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; color: #17121f; background: #fbfaff; font-family: "Plus Jakarta Sans", sans-serif; }
  :global(a) { color: inherit; }
  :global(:focus-visible) { outline: 3px solid #ffad2f; outline-offset: 4px; }
  .skip-link { position: fixed; left: 1rem; top: 1rem; z-index: 100; padding: .7rem 1rem; background: white; transform: translateY(-160%); transition: transform .2s; }
  .skip-link:focus { transform: none; }
  .site-header { height: 86px; padding: 0 clamp(1.25rem, 5vw, 5rem); display: flex; align-items: center; gap: 3rem; border-bottom: 1px solid #e7e2ed; background: rgba(251,250,255,.9); backdrop-filter: blur(18px); position: sticky; top: 0; z-index: 50; }
  .brand img, footer img { display: block; width: 158px; height: auto; }
  nav { margin-left: auto; display: flex; gap: 2.2rem; }
  nav a { color: #5b5364; font-size: .86rem; font-weight: 700; text-decoration: none; }
  .header-cta { padding: .75rem 1.1rem; border: 1px solid #4b168f; border-radius: 999px; color: #4b168f; font-size: .82rem; font-weight: 800; text-decoration: none; }
  .hero { min-height: calc(100svh - 86px); padding: clamp(5rem, 10vw, 9rem) clamp(1.25rem, 7vw, 7.5rem); display: grid; grid-template-columns: 1.03fr .97fr; align-items: center; gap: 4rem; overflow: hidden; background: radial-gradient(circle at 80% 40%, #f0e7ff 0, transparent 35%), #fbfaff; }
  .eyebrow, .section-label { color: #5c1ca4; text-transform: uppercase; letter-spacing: .16em; font-size: .72rem; font-weight: 800; }
  .eyebrow { display: flex; align-items: center; gap: .7rem; }
  .eyebrow span { width: 28px; height: 2px; background: #ffad2f; }
  h1, h2, h3 { font-family: "Space Grotesk", sans-serif; margin: 0; letter-spacing: -.045em; }
  h1 { font-size: clamp(3.8rem, 7.2vw, 7.5rem); line-height: .89; font-weight: 600; }
  h1 em, .final-cta em { color: #5c1ca4; font-style: normal; }
  .hero-lead { max-width: 620px; margin: 2rem 0; color: #665d6f; font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; gap: 1.8rem; flex-wrap: wrap; }
  .button { display: inline-flex; align-items: center; gap: 2rem; padding: 1rem 1.25rem; border-radius: 8px; font-size: .86rem; font-weight: 800; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .button:hover { transform: translateY(-3px); }
  .button-primary { color: white; background: #5c1ca4; box-shadow: 0 12px 30px rgba(75,22,143,.18); }
  .text-link { color: #5c1ca4; font-size: .85rem; font-weight: 800; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .orbit { position: relative; min-height: 580px; display: grid; place-items: center; }
  .orbit::before { content: ""; position: absolute; width: 470px; aspect-ratio: 1; border-radius: 50%; background: #5c1ca4; box-shadow: 0 28px 80px rgba(75,22,143,.25); }
  .orbit-ring { position: absolute; border: 1px dashed rgba(92,28,164,.28); border-radius: 50%; }
  .ring-one { width: 550px; height: 550px; }
  .ring-two { width: 700px; height: 700px; }
  .profile-card { position: relative; z-index: 2; width: 330px; padding: 0 1.7rem 1.7rem; border-radius: 18px; background: white; box-shadow: 0 20px 50px rgba(28,8,51,.25); overflow: hidden; }
  .profile-cover { height: 92px; margin: 0 -1.7rem 2.6rem; background: linear-gradient(135deg, #33105e, #7132bd); }
  .profile-logo { position: absolute; top: 52px; left: 1.7rem; display: block; width: 72px; height: auto; border: 5px solid white; border-radius: 15px; }
  .profile-kicker { margin: 0 0 .5rem; color: #8c8298; font-size: .61rem; font-weight: 800; letter-spacing: .13em; }
  .profile-card h2 { font-size: 1.7rem; }
  .profile-status { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #eee9f2; color: #665d6f; font-size: .72rem; font-weight: 700; }
  .profile-status i { display: inline-block; width: 7px; height: 7px; margin-right: .4rem; border-radius: 50%; background: #3bb273; }
  .orbit-pill { position: absolute; z-index: 3; padding: .72rem 1rem; border: 1px solid rgba(92,28,164,.15); border-radius: 999px; background: white; color: #4b168f; box-shadow: 0 10px 25px rgba(54,23,82,.11); font-size: .72rem; font-weight: 800; }
  .pill-event { top: 10%; left: 6%; } .pill-impact { top: 20%; right: -2%; } .pill-donor { bottom: 13%; left: 1%; } .pill-story { bottom: 9%; right: 3%; }
  .manifesto { padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 9vw, 10rem); display: grid; grid-template-columns: 1fr 3fr; gap: 4rem; border-top: 1px solid #e5deeb; }
  .manifesto h2 { font-size: clamp(2.7rem, 5vw, 5.2rem); line-height: 1.02; }
  .manifesto h2 span { color: #8a8093; }
  .manifesto div > p { max-width: 720px; margin: 2rem 0 0 auto; color: #665d6f; font-size: 1.08rem; line-height: 1.8; }
  .movement { padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 7vw, 7.5rem); display: grid; grid-template-columns: .82fr 1.18fr; gap: clamp(4rem, 8vw, 8rem); color: white; background: #4b168f; }
  .movement-lead { align-self: center; }
  .movement-lead h2 { max-width: 650px; margin: 1.2rem 0 1.8rem; font-size: clamp(3rem, 5vw, 5.5rem); line-height: .96; }
  .movement-lead h2 em { color: #ffad2f; font-style: normal; }
  .movement-lead > p:not(.section-label) { max-width: 570px; color: #e0cfee; font-size: 1rem; line-height: 1.8; }
  .movement-link { display: inline-block; margin-top: 1.2rem; color: white; }
  .movement-board { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid rgba(255,255,255,.25); border-left: 1px solid rgba(255,255,255,.25); }
  .movement-board article { min-height: 260px; padding: clamp(1.5rem, 3vw, 2.4rem); border-right: 1px solid rgba(255,255,255,.25); border-bottom: 1px solid rgba(255,255,255,.25); }
  .movement-meta { display: flex; justify-content: space-between; color: #d4bce9; font-size: .63rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .movement-meta span { color: #ffbd52; }
  .movement-board h3 { margin: 4.5rem 0 .9rem; font-size: clamp(1.45rem, 2.2vw, 2rem); }
  .movement-board p { margin: 0; color: #dac8e8; font-size: .82rem; line-height: 1.7; }
  .editorial { padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 7vw, 7.5rem); background: #fbfaff; }
  .editorial-heading { margin-bottom: 3rem; display: grid; grid-template-columns: 1.35fr .65fr; align-items: end; gap: 3rem; }
  .editorial-heading h2 { margin-top: 1rem; font-size: clamp(2.8rem, 5vw, 5.4rem); line-height: .98; }
  .editorial-heading > p { margin: 0; color: #665d6f; line-height: 1.75; }
  .story-grid { display: grid; grid-template-columns: 1.08fr .92fr .92fr; min-height: 420px; }
  .story-card { position: relative; padding: clamp(1.5rem, 3vw, 2.5rem); display: flex; flex-direction: column; justify-content: flex-end; color: white; text-decoration: none; overflow: hidden; isolation: isolate; }
  .story-card::before { content: ""; position: absolute; inset: 0; z-index: -2; background: radial-gradient(circle at 72% 22%, rgba(255,255,255,.13), transparent 27%), repeating-linear-gradient(125deg, transparent 0 34px, rgba(255,255,255,.055) 35px 36px); transition: transform .3s; }
  .story-card:hover::before { transform: scale(1.05); }
  .story-1 { background: #30104d; }
  .story-2 { background: #5c1ca4; }
  .story-3 { color: #2f1048; background: #ffad2f; }
  .story-type { margin-bottom: auto; font-size: .65rem; font-weight: 800; letter-spacing: .16em; }
  .story-card strong { max-width: 420px; font: 600 clamp(1.7rem, 3vw, 3rem)/1.04 "Space Grotesk", sans-serif; letter-spacing: -.04em; }
  .story-arrow { position: absolute; top: 1.7rem; right: 1.7rem; font-size: 1.2rem; }
  .story-pitch { margin-top: 1.5rem; padding: 1.5rem 0; display: flex; align-items: center; justify-content: space-between; gap: 2rem; border-bottom: 1px solid #ddd5e4; }
  .story-pitch p { margin: 0; color: #665d6f; }
  .story-pitch strong { color: #17121f; }
  .solutions { padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 7vw, 7.5rem); display: grid; grid-template-columns: .8fr 1.2fr; gap: 6rem; color: white; background: #27073f; }
  .section-label.light { color: #d9bfff; }
  .section-intro h2 { margin: 1.2rem 0 1.5rem; font-size: clamp(3rem, 5vw, 5.5rem); line-height: .98; }
  .section-intro > p:last-child { max-width: 400px; color: #cbbdd5; line-height: 1.75; }
  .capability-grid { display: grid; grid-template-columns: repeat(2, 1fr); }
  .capability-grid article { min-height: 250px; padding: 2rem; border: 1px solid rgba(255,255,255,.14); transition: background .2s, transform .2s; }
  .capability-grid article:hover { background: rgba(255,255,255,.06); transform: translateY(-4px); }
  .capability-icon { color: #ffad2f; font-size: 1.7rem; }
  .capability-grid h3 { margin: 3.2rem 0 .8rem; font-size: 1.45rem; }
  .capability-grid p { margin: 0; color: #bfb1ca; font-size: .88rem; line-height: 1.7; }
  .open { padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 9vw, 10rem); display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .open-visual { min-height: 480px; display: grid; place-items: center; background: repeating-linear-gradient(45deg, #f3eff7, #f3eff7 1px, transparent 1px, transparent 20px); }
  .code-window { width: min(90%, 520px); border-radius: 14px; color: #e9dff0; background: #1a0b27; box-shadow: 0 24px 60px rgba(26,11,39,.2); overflow: hidden; transform: rotate(-2deg); }
  .code-bar { display: flex; align-items: center; gap: 7px; padding: .85rem 1rem; border-bottom: 1px solid #402552; color: #8e7e9a; font: .68rem monospace; }
  .code-bar i { width: 8px; height: 8px; border-radius: 50%; background: #714f83; } .code-bar span { margin-left: .6rem; }
